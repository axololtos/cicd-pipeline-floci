    {"type":"text","id":"e2_text","x":304,"y":742,"width":390,"height":226,"text":"appspec.yml (hooks run in the instance)\nhooks:\n  AfterInstall:\n    - location: /scripts/start.sh\n  ValidateService:\n    - location: /scripts/validate.sh\n\nstart.sh\naws s3 cp s3://nextwork-artifacts/<war>\n       /opt/tomcat/webapps/ROOT.war\nstartup.sh            # Tomcat 9\n\nvalidate.sh\ncurl http://localhost:8080/ until 200","originalText":"appspec.yml (hooks run in the instance)\nhooks:\n  AfterInstall:\n    - location: /scripts/start.sh\n  ValidateService:\n    - location: /scripts/validate.sh\n\nstart.sh\naws s3 cp s3://nextwork-artifacts/<war>\n       /opt/tomcat/webapps/ROOT.war\nstartup.sh            # Tomcat 9\n\nvalidate.sh\ncurl http://localhost:8080/ until 200","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300041,"version":1,"versionNonce":300042,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
